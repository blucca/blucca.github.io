+@pytest.mark.asyncio
+async def test_call_tool_preserves_custom_meta_values_in_upstream_request() -> None:
+    from mcp.types import TextContent
+
+    custom_meta: Final[dict[str, JsonValue]] = {
+        "correlation": "request-1",
+        "nullable": None,
+        "nested": {"nil": None, "enabled": False},
+        "array": [None, {"enabled": False}, "tail"],
+        "zero": 0,
+        "disabled": False,
+    }
+    service: Final = UpstreamServer("metadata")
+
+    @service.tool()
+    def inspect_meta(query: str, ctx: Context) -> str:
+        metadata: Final = TypeAdapter(dict[str, JsonValue]).validate_python(ctx.request_context.meta or {})
+        return json.dumps({"arguments": {"query": query}, "meta": metadata})
+
+    client: Final = _InProcessUpstreamClient(service)
+    result: Final = await client.call_tool(
+        CallToolRequestParams(name="inspect_meta", arguments={"query": "hello"}, _meta=custom_meta),
+        raise_on_error=True,
+    )
+    assert isinstance(result, CallToolResult)
+    assert result.is_error is False
+    assert isinstance(result.content[0], TextContent)
+    observed: Final = TypeAdapter(dict[str, JsonValue]).validate_json(result.content[0].text)
+    observed_meta: Final = TypeAdapter(dict[str, JsonValue]).validate_python(observed["meta"])
+    assert {key: observed_meta[key] for key in custom_meta} == custom_meta
+    assert observed["arguments"] == {"query": "hello"}
