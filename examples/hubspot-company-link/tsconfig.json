{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "*.ts",
    "*.tsx"
  ],
  "exclude": [
    "vitest.config.ts"
  ]
}
